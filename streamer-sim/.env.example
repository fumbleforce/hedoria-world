# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key — safe to expose in the browser bundle.
# Find them in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── LemonSqueezy ────────────────────────────────────────────────────────────
# Store ID and the full checkout URL for your product variant.
# Find them in: LemonSqueezy dashboard → Stores / Products
VITE_LEMONSQUEEZY_STORE_ID=12345
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/buy/your-variant-id

# ── LLM (dev only — never VITE_ prefix, stays server-side) ──────────────────
# Used by the Vite dev-server proxy in vite.config.ts.
# In production the equivalent secret is set in Supabase edge function secrets.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_APP_TITLE=Limelight

# ── Gemini (optional, dev only) ─────────────────────────────────────────────
# Direct browser → Google. Dev/personal use only; never use in production.
# VITE_GEMINI_API_KEY=AIza...
